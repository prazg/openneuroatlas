  "definitions": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authors",
        "title",
        "venue",
        "year",
        "bibtexKey",
        "doi"
      ],
      "properties": {
        "authors": {
          "type": "string",
          "required": true,
          "nullable": false,
          "minLength": 3,
          "maxLength": 600,
          "description": "Authors in standard BibTeX 'Last, First and Last, First' format (use 'and others' for truncated consortium lists).",
          "ui": {
            "label": "Authors (BibTeX format)",
            "inputType": "text",
            "placeholder": "Bakas, Spyridon and Sako, Chiharu and Akbari, Hamed and others",
            "helpText": "Separate multiple authors with ' and ' in 'Last, First' order so BibTeX, RIS, and APA exporters parse cleanly."
          }
        },
        "title": {
          "type": "string",
          "required": true,
          "nullable": false,
          "minLength": 5,
          "maxLength": 350,
          "description": "Primary publication, preprint, or dataset title.",
          "ui": {
            "label": "Publication / Dataset Title",
            "inputType": "text",
            "placeholder": "The University of Pennsylvania glioblastoma (UPENN-GBM) cohort...",
            "helpText": "Canonical title of the primary reference paper or dataset release."
          }
        },
        "venue": {
          "type": "string",
          "required": true,
          "nullable": false,
          "minLength": 2,
          "maxLength": 180,
          "description": "Journal name, conference proceedings, preprint server, or repository name.",
          "ui": {
            "label": "Venue / Journal",
            "inputType": "text",
            "placeholder": "Scientific Data",
            "helpText": "e.g., Scientific Data, IEEE TMI, Nature Methods, MICCAI, arXiv, GitHub."
          }
        },
        "year": {
          "type": "integer",
          "required": true,
          "nullable": false,
          "minimum": 1990,
          "maximum": 2035,
          "description": "Four-digit publication year of the citation.",
          "ui": {
            "label": "Citation Year",
            "inputType": "number",
            "placeholder": "2022",
            "helpText": "Four-digit year matching the cited reference."
          }
        },
        "bibtexKey": {
          "type": "string",
          "required": true,
          "nullable": false,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,63}$",
          "description": "Unique BibTeX citation key (alphanumeric, underscores, hyphens; starts with a letter).",
          "ui": {
            "label": "BibTeX Key",
            "inputType": "text",
            "placeholder": "bakas2022upenngbm",
            "helpText": "Recommended format: <firstauthor><year><shortslug> (no spaces or special symbols)."
          }
        },
        "doi": {
          "type": "string",
          "required": true,
          "nullable": true,
          "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$",
          "description": "Bare DOI without 'https://doi.org/' prefix, or null if no DOI exists.",
          "ui": {
            "label": "DOI (optional — leave blank for null)",
            "inputType": "text",
            "placeholder": "10.1038/s41597-022-01560-7",
            "helpText": "Enter bare DOI starting with '10.' (do not include https://doi.org/)."
          }
        }
      }
    }
  },
