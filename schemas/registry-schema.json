{
  "schemaVersion": "1.0.0",
  "title": "OpenNeuroAtlas Registry Schema",
  "description": "Machine-readable single source of truth defining controlled vocabularies, file envelopes, record field rules, cross-record integrity constraints, and PR Builder form metadata for OpenNeuroAtlas. Consumed directly by tests/validate_registry.py (Python 3.12 stdlib) and js/prBuilder.js + js/registryEngine.js + js/analyticsCharts.js in the browser.",
  "fileEnvelope": {
    "required": [
      "schemaVersion",
      "recordType",
      "lastUpdated",
      "records"
    ],
    "additionalProperties": false,
    "properties": {
      "schemaVersion": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$",
        "description": "Semantic version matching schemas/registry-schema.json."
      },
      "recordType": {
        "type": "string",
        "enum": [
          "datasets",
          "models",
          "challenges"
        ],
        "description": "Collection identifier matching the filename in data/<recordType>.json."
      },
      "lastUpdated": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "ISO 8601 date (YYYY-MM-DD) of the most recent registry update."
      },
      "records": {
        "type": "array",
        "minItems": 0,
        "description": "Ordered array of validated registry entries."
      }
    }
  },
