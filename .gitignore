*.py[cod]
*$py.class
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# OS & desktop artifacts
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

